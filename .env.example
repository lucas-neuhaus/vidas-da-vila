# Configuração local do PostgreSQL
POSTGRES_USER=vidas
POSTGRES_DB=vidas_dev
POSTGRES_HOST_PORT=15432
WEB_HOST_PORT=8080
POSTGRES_PASSWORD=replace-with-local-password

# A URL abaixo é para executar a API fora do Docker.
# Use os mesmos valores de usuário, senha e banco acima.
DATABASE_URL=postgresql+psycopg://vidas:replace-with-local-password@127.0.0.1:5432/vidas_dev

# Substitua por um token ASCII aleatório de pelo menos 32 caracteres.
ADMIN_API_TOKEN=
